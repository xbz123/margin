          '        const changed = this.apiKey !== apiKey;\n' +
          '        this.apiKey = apiKey;\n' +
          "        console.log('[OpenAIStreaming] API key updated');\n" +
          "        // The WebSocket's Authorization header is sent in the handshake and cannot\n" +
          "        // be updated on an established connection. If we're already streaming, the\n" +
