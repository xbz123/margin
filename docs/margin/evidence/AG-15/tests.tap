          "import { OpenAITranscriptTurnCoalescer } from './openaiTranscriptTurnCoalescer';\n" +
          '\n' +
          '// ─── Constants ────────────────────────────────────────────────────────────────\n' +
          '\n' +
          "const DEFAULT_OPENAI_BASE = 'https://api.openai.com';\n" +
          "const REALTIME_WS_URL = 'wss://api.openai.com/v1/realtime?intent=transcription';\n" +
          "const REST_ENDPOINT   = 'https://api.openai.com/v1/audio/transcriptions';\n" +
          '\n' +
          '/** Derive REST transcription endpoint from a user-supplied base URL.\n' +
          " *  Strips a trailing slash so we don't end up with `//v1/...`. Accepts both\n" +
          ' *  `https://my-host.tld` and `https://my-host.tld/v1` (the latter occurs in the wild). */\n' +
          'function deriveRestEndpoint(baseUrl: string): string {\n' +
          "    const trimmed = baseUrl.replace(/\\/+$/, '');\n" +
          '    return /\\/v\\d+$/.test(trimmed)\n' +
          '        ? `${trimmed}/audio/transcriptions`\n' +
          '        : `${trimmed}/v1/audio/transcriptions`;\n' +
          '}\n' +
          '\n' +
          '/** WebSocket model priority order */\n' +
          "const WS_MODELS = ['gpt-4o-transcribe', 'gpt-4o-mini-transcribe'] as const;\n" +
          'type WsModel = typeof WS_MODELS[number];\n' +
          '\n' +
          '/** Max consecutive WebSocket failures before advancing to next model / REST */\n' +
          'const MAX_WS_FAILURES_PER_MODEL = 3;\n' +
          '\n' +
          '/** Exponential backoff reconnect delays */\n' +
          'const RECONNECT_BASE_MS = 1000;\n' +
          'const RECONNECT_MAX_MS  = 30_000;\n' +
          '\n' +
          '/** Keep-alive ping interval (ms) — prevents idle disconnects */\n' +
          'const KEEPALIVE_INTERVAL_MS = 20_000;\n' +
          '\n' +
          '/** Rolling audio ring-buffer: sized for worst-case raw INPUT audio (48kHz stereo 16-bit × 30s).\n' +
          ' *  The ring buffer stores PRE-RESAMPLED chunks from write(), not the 24kHz WS output. */\n' +
          'const MAX_RING_BUFFER_BYTES = 48_000 * 2 * 2 * 30; // 5 760 000 bytes (48kHz stereo × 16-bit × 30s)\n' +
          '\n' +
          '/** REST safety-net flush interval when in REST fallback mode */\n' +
          'const REST_SAFETY_NET_MS = 10_000;\n' +
          '\n' +
          '/** Minimum buffered bytes before attempting a REST upload */\n' +
          'const REST_MIN_UPLOAD_BYTES = 4_000;\n' +
          '\n' +
          '/** WebSocket Audio Batching: Number of 24kHz samples to accumulate before sending to prevent rate limits (~250ms) */\n' +
          'const SEND_THRESHOLD_SAMPLES = 6000;\n' +
          '\n' +
          '/** Silence RMS threshold — skip REST uploads for silent buffers */\n' +
