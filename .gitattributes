# Normalize line endings to LF for all text files
* text=auto eol=lf

# Explicitly declare text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.rs text eol=lf
*.toml text eol=lf

# Binary files — don't touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.node binary

# Raw gate output kept unedited as evidence (docs/margin/evidence/README.md)
docs/margin/evidence/** -whitespace
docs/margin/evidence/README.md whitespace

# Third-party notice bytes are hash-verified originals, including their whitespace.
licenses/texts/*.txt -text -whitespace

# Original Readme headings use seven equals signs; preserve their bytes without conflict-marker false positives.
licenses/texts/4755231c711c7dfde41435042b01a1687f1082baea6eba68e3f83171f4e7ae2c.txt conflict-marker-size=8
scripts/margin/license-inputs/original-notices/format-0.2.2-readme-license.txt conflict-marker-size=8
