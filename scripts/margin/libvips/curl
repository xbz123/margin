#!/usr/bin/env bash
# Put first on PATH while the sharp-libvips recipe runs (PLAN S19-C). Every URL the
# recipe fetches with curl is downloaded once to a file, kept under
# $MARGIN_CAPTURE_DIR/files with its sha256 recorded in manifest.tsv, and then
# handed on exactly as curl would have (stdout, or -O into the working directory).
set -euo pipefail
real=/usr/bin/curl
url=""
remote_name=0
for arg in "$@"; do
  case "$arg" in
    http://*|https://*) url="$arg" ;;
    -O|--remote-name) remote_name=1 ;;
  esac
done
if [ -z "$url" ] || [ -z "${MARGIN_CAPTURE_DIR:-}" ]; then exec "$real" "$@"; fi
mkdir -p "$MARGIN_CAPTURE_DIR/files"
tmp="$(mktemp "$MARGIN_CAPTURE_DIR/files/.partial.XXXXXX")"
args=()
for arg in "$@"; do [ "$arg" = "-O" ] || [ "$arg" = "--remote-name" ] || args+=("$arg"); done
"$real" "${args[@]}" --fail --output "$tmp"
sum="$(shasum -a 256 "$tmp" | cut -d' ' -f1)"
name="$(basename "${url%%\?*}")"
dest="$MARGIN_CAPTURE_DIR/files/$sum-$name"
mv -f "$tmp" "$dest"
printf '%s\t%s\t%s\t%s\n' "$sum" "$(stat -f %z "$dest")" "$name" "$url" >> "$MARGIN_CAPTURE_DIR/manifest.tsv"
if [ "$remote_name" = 1 ]; then cp "$dest" "./$name"; else cat "$dest"; fi
